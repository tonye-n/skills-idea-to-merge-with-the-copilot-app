---
// Bookmarks component.
//
// The markup renders during the static build. All dynamic behavior and every
// localStorage access lives in the client-side <script> at the bottom, which
// Astro bundles for the browser only. Pure logic is in src/lib/bookmarks.ts.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only, never during the build.
  import {
    STORAGE_KEY,
    SEPARATOR,
    normalizeUrl,
    parseStored,
    serialize,
    uniqueSlug,
    type Bookmark,
  } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');
  const hint = document.querySelector('.hint');

  let bookmarks: Bookmark[] = [];
  // Used when localStorage is unavailable (private mode, quota, etc.).
  let storageOk = true;

  function load(): Bookmark[] {
    try {
      return parseStored(localStorage.getItem(STORAGE_KEY));
    } catch {
      storageOk = false;
      return [];
    }
  }

  function save() {
    try {
      localStorage.setItem(STORAGE_KEY, serialize(bookmarks));
    } catch {
      storageOk = false;
    }
  }

  function setMessage(text: string, isError = false) {
    if (!hint) return;
    hint.textContent = text;
    hint.classList.toggle('error', isError);
  }

  function render() {
    if (!list) return;
    list.replaceChildren();
    for (const b of bookmarks) {
      const li = document.createElement('li');
      li.className = 'bookmark';

      const a = document.createElement('a');
      a.className = 'url';
      a.href = b.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = b.url;

      const sep = document.createElement('span');
      sep.className = 'sep';
      sep.textContent = SEPARATOR;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = b.slug;

      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'copy';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', `Copy ${b.slug}`);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.slug);
          copy.textContent = 'Copied!';
        } catch {
          copy.textContent = 'Copy failed';
        }
        setTimeout(() => (copy.textContent = 'Copy'), 1200);
      });

      li.append(a, sep, slug, copy);
      list.append(li);
    }
    const has = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = has;
    if (listHeader) listHeader.hidden = !has;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // must stay first — a native submit would reload and lose the URL
    try {
      const url = normalizeUrl(input?.value);
      if (!url) {
        setMessage('Enter a valid web address, like example.com.', true);
        input?.focus();
        return;
      }
      bookmarks = [...bookmarks, { url, slug: uniqueSlug(bookmarks) }];
      save();
      render();
      if (input) input.value = '';
      setMessage(
        storageOk
          ? 'Saved! Add another link any time.'
          : 'Saved for this visit only — your browser blocked storage.',
        !storageOk,
      );
    } catch {
      setMessage('Something went wrong. Please try again.', true);
    }
  });

  clearAll?.addEventListener('click', () => {
    if (!confirm('Remove all saved bookmarks?')) return;
    bookmarks = [];
    save();
    render();
  });

  bookmarks = load();
  render();
</script>
